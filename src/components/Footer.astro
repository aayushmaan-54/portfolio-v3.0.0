---
import Socials from "./Socials.astro";
import Profile from "@/data/profile";
import { SITE } from "@/config/site.config";

const timezone = SITE.timezone;
---

<hr />
<div class="my-10 flex flex-col gap-6">
  <div class="flex items-start justify-between gap-4">
    <Socials />
    <button
      type="button"
      data-shortcuts-open
      data-haptic="tap"
      title="keyboard shortcuts"
      aria-label="Show keyboard shortcuts"
      class="hidden shrink-0 text-foreground-muted hover:text-foreground-primary transition-colors focus-visible:outline-none focus-visible:underline underline-offset-4 pointer-fine:inline"
    >
      [?]
    </button>
  </div>

  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm text-foreground-muted"
  >
    <span>&copy; {new Date().getFullYear()} {Profile.name}</span>
    <span>
      {Profile.location} · <time data-local-time>--:--:--</time>
    </span>
  </div>
</div>

<script is:inline define:vars={{ timezone }}>
  (() => {
    const el = document.querySelector("[data-local-time]");
    if (!el) return;

    const format = new Intl.DateTimeFormat("en-IN", {
      timeZone: timezone,
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
      timeZoneName: "short",
    });

    const tick = () => {
      const now = new Date();
      const parts = format.formatToParts(now);
      const get = (type) => parts.find((p) => p.type === type)?.value ?? "";

      el.textContent = `${get("hour")}:${get("minute")}:${get("second")} ${get("timeZoneName")}`;
      el.dateTime = now.toISOString();

      // Re-run at the start of the next second.
      setTimeout(tick, 1000 - now.getMilliseconds());
    };

    tick();
  })();
</script>
