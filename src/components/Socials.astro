---
import socialLinks from "@/data/socials";
---

<div class="flex flex-wrap gap-x-6 gap-y-2">
  {
    socialLinks.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        title={`${social.label} (opens in a new tab)`}
        data-haptic="nav"
        class="tap-target text-foreground-muted hover:text-foreground-primary transition-colors hover:underline underline-offset-4 focus-visible:outline-none focus-visible:underline focus-visible:text-foreground-primary"
      >
        [{social.label} ↗]
      </a>
    ))
  }
</div>
