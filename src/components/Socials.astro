---
import socialLinks from "@/data/socials";
---

<div class="flex flex-wrap gap-x-6 gap-y-2">
  {
    socialLinks.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        title={
          "copy" in social ? undefined : `${social.label} (opens in a new tab)`
        }
        aria-label={
          "copy" in social
            ? `${social.label}: click to copy email, double-click to open mail app`
            : undefined
        }
        data-copy={"copy" in social ? social.copy : undefined}
        data-tooltip={
          "copy" in social
            ? "click to copy · double-click to open mail"
            : undefined
        }
        data-haptic="nav"
        class:list={[
          "tap-target text-link transition-colors hover:underline underline-offset-4 focus-visible:outline-none focus-visible:underline",
          "copy" in social && "tooltip",
        ]}
      >
        [{social.label} ↗]
      </a>
    ))
  }
</div>
