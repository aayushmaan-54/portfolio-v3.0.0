---
import stack from "@/data/TechStack";
import { Icon } from "astro-icon/components";
---

<h2 class="text-2xl font-semibold mt-16 sm:mt-20 sm:text-3xl">
  <span class="opacity-30 mr-2" aria-hidden="true">#</span>stack
</h2>

<div class="mt-5 font-mono text-sm">
  {
    stack.map((group) => (
      <div class="border-b border-border-primary last:border-b-0">
        <div class="grid gap-3 py-3 px-0 sm:grid-cols-[160px_1fr] sm:gap-4 sm:px-2">
          <span class="text-foreground-muted uppercase tracking-wide text-xs pt-1">
            {group.category}
          </span>
          <div class="flex flex-wrap gap-x-4 gap-y-3 cursor-default">
            {group.items.map((tech) => (
              <span class="flex min-w-0 items-center gap-2 text-foreground-secondary hover:text-foreground-primary transition-colors">
                <Icon
                  name={tech.icon}
                  class="w-4 h-4 shrink-0"
                  aria-hidden="true"
                />
                {tech.name}
              </span>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>
