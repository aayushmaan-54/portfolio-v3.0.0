---
import credentials from "@/data/credentials";
import { Icon } from "astro-icon/components";
---

<h2 class="text-2xl font-semibold mt-16 sm:mt-20 sm:text-3xl">
  <span class="opacity-30 mr-2" aria-hidden="true">#</span>credentials
</h2>

<div class="mt-5">
  {
    credentials.map((cred) => (
      <a
        href={cred.verifyUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-haptic="nav"
        class="group block border-b border-border-primary last:border-b-0 px-0 py-4 hover:bg-background-hover hover:border-border-hover transition-colors sm:p-4"
      >
        <div class="flex items-start justify-between gap-4">
          <div class="flex min-w-0 items-start gap-3">
            <Icon name={cred.icon} class="w-6 h-6 shrink-0" aria-hidden="true" />
            <div class="min-w-0">
              <h3 class="font-bold">{cred.title}</h3>
              <p class="text-sm text-foreground-muted">{cred.issuer}</p>
            </div>
          </div>
          <span class="shrink-0 text-sm text-foreground-muted group-hover:text-foreground-primary">
            verify{" "}
            <span class="inline-block transition-transform group-hover:-translate-y-0.5">
              ↗
            </span>
          </span>
        </div>
      </a>
    ))
  }
</div>
