---
import { Image } from "astro:assets";
import education from "@/data/education";
---

<h2 class="text-2xl font-semibold mt-16 sm:mt-20 sm:text-3xl">
  <span class="opacity-30 mr-2" aria-hidden="true">#</span>education
</h2>

<div class="mt-5">
  {
    education.map((edu) => {
      return (
        <div class="border-b border-border-primary last:border-b-0 px-0 py-4 hover:bg-background-hover hover:border-border-hover transition-colors cursor-default sm:p-4">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="font-bold flex min-w-0 items-start gap-2 wrap-break-word">
              <Image
                src={edu.logo}
                alt={`${edu.institution} logo`}
                width={20}
                height={20}
                densities={[1, 2]}
                class="w-5 shrink-0"
              />
              {edu.degree}
            </h3>
            <span class="text-sm text-foreground-muted sm:shrink-0">
              {edu.duration}
            </span>
          </div>
          <p class="text-sm text-foreground-muted">{edu.institution}</p>
          <p class="mt-1 text-sm text-foreground-muted">
            {edu.location} • {edu.affiliation}
          </p>
          <p class="mt-2 text-foreground-secondary">{edu.field}</p>
        </div>
      );
    })
  }
</div>
