---
import Layout from "@/layouts/BaseLayout.astro";
---

<Layout pageTitle="404" title="Page Not Found">
  <div class="flex flex-col items-start gap-2 mt-20 sm:mt-32">
    <p class="text-foreground-muted">// error</p>
    <h1 data-text="404" class="text-3xl font-bold font-pixel sm:text-4xl glitch-name">
      404
    </h1>

    <p class="mt-2 text-foreground-secondary">
      This path doesn't exist. Might've been moved, renamed, or never was.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-sm">
      <span class="text-foreground-muted">$</span>
      <span class="text-foreground-secondary">cd</span>
      <a
        href="/"
        class="text-foreground-primary underline underline-offset-4
      hover:text-foreground-muted transition-colors"
      >
        ~/home
      </a>
      <span class="inline-block w-2 h-4 bg-foreground-primary animate-blink"
      ></span>
    </div>
  </div>
</Layout>
