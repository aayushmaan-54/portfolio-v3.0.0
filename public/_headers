# Fingerprinted build output (CSS/JS/fonts) — safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images are served straight from public/, so their names are NOT
# content-hashed. Cache for a day only — a longer TTL means replacing an
# image leaves stale copies in caches until it expires.
/images/*
  Cache-Control: public, max-age=86400

# Global rules for all HTML pages and assets
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# HTML must always revalidate to prevent stale, broken image hashes
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
